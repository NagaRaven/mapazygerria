# =============================================
# VARIABLES DE ENTORNO - ZYGERRIA MAP BACKEND
# =============================================
# Copia este archivo como .env y rellena los valores.
# En Railway, configura estas variables en el dashboard.

# ---- Servidor ----
PORT=3001
NODE_ENV=production

# ---- Base de datos ----
# Usar SQLite (no requiere servidor externo)
DB_TYPE=sqlite
# Ruta del directorio de datos. En Railway, monta un volumen en /data
DATA_DIR=/data

# ---- Autenticación ----
# Genera un secreto seguro con: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_una_clave_segura_aleatoria
JWT_EXPIRES_IN=24h

# ---- CORS ----
# URL pública de tu app en Railway (misma URL para frontend y backend)
FRONTEND_URL=https://tu-proyecto.up.railway.app
